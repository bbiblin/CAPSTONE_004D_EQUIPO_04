<mxfile host="app.diagrams.net" agent="opencode" version="24.4.0">
  <diagram id="comunicacion-servicios" name="Comunicación entre servicios">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ ACTORES ============ -->
        <mxCell id="a_ciudadano" value="Usuario / Ciudadano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="170" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_admin" value="Admin / Moderador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="140" height="60" as="geometry" />
